{
  "name": "test-app",
  "version": "0.0.0",
  "private": true,
  "description": "Test app for @universal-ember/test-support",
  "repository": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "imports": {
    "#app/*": "./app/*",
    "#config": "./app/config.ts"
  },
  "scripts": {
    "build:test": "EMBER_ENV=test NODE_ENV=development vite build --mode development",
    "lint": "ember-tsc --noEmit",
    "lint:fix": "echo 'nothing to fix'",
    "start": "vite",
    "test": "pnpm build:test && pnpm test:ci",
    "test:ci": "testem ci --port 0",
    "test:ember": "pnpm test"
  },
  "dependencies": {
    "@universal-ember/test-support": "workspace:*",
    "ember-modifier": "^4.3.0",
    "ember-primitives": "^0.61.1",
    "ember-resources": "^7.1.0",
    "expect-type": "^0.18.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/plugin-transform-runtime": "^8.0.0",
    "@babel/plugin-transform-typescript": "^8.0.0",
    "@babel/runtime": "^8.0.0",
    "@ember/app-tsconfig": "^2.0.0",
    "@ember/test-helpers": "^5.4.1",
    "@ember/test-waiters": "^4.1.0",
    "@embroider/core": "^4.4.2",
    "@embroider/macros": "^1.20.3",
    "@glimmer/component": "^2.1.1",
    "@glint/ember-tsc": "^1.7.5",
    "@glint/template": "^1.7.7",
    "@nullvoxpopuli/ember-vite": "^1.1.0",
    "@types/qunit": "^2.19.12",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "decorator-transforms": "^2.3.2",
    "ember-qunit": "^9.0.4",
    "ember-source": "^7.0.0",
    "ember-strict-application-resolver": "^0.1.0",
    "qunit": "^2.25.0",
    "qunit-dom": "^3.5.0",
    "qunit-theme-ember": "^1.0.0",
    "testem": "^3.17.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.14"
  },
  "engines": {
    "node": ">= 24"
  },
  "ember": {
    "edition": "octane"
  },
  "dependenciesMeta": {
    "@universal-ember/test-support": {
      "injected": true
    }
  }
}
